{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "bundler",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2020"
        ],
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true
    },
    "include": ["static/**/*.ts"],
    "exclude": ["node_modules"]
}
