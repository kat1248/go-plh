{
  "name": "go-plh",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint 'static/**/*.js' --max-warnings=0",
    "lint:css": "stylelint 'static/**/*.css'",
    "format": "prettier --write 'static/**/*.ts'",
    "check": "npm run lint && npm run lint:css && npx prettier --check 'static/**/*.ts'",
    "build": "tsc"  },
  "devDependencies": {
    "@types/datatables.net": "^1.10.28",
    "@types/datatables.net-rowgroup": "^1.1.5",
    "@types/jquery": "^3.5.33",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.7.4",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^5.9.3"
  }
}
